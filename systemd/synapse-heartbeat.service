[Unit]
Description=SYNAPSE Heartbeat - Reporta estado del nodo al OpsAgent
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Credenciales (service token de Access) en /etc/synapse/ops-worker.env, no aquí.
Environment=SYNAPSE_NODE_NAME=CHANGE-ME
ExecStart=/usr/local/bin/synapse-heartbeat.sh
User=root
